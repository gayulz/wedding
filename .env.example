# ===================================================================
# 청첩장 템플릿 환경변수 설정
# ===================================================================
# 이 파일을 .env.local로 복사하여 실제 값을 입력하세요.
# .env.local 파일은 Git에 커밋되지 않습니다.
# ===================================================================

# ===== 클라이언트 환경변수 (VITE_) =====
# 브라우저에서 접근 가능하며, 빌드 후 번들에 포함됩니다.
# API 키는 도메인 제한 설정을 권장합니다.

# Firebase Configuration (방명록 기능)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id   # Analytics 전용. 비워둬도 Firestore는 동작합니다

# Kakao API (카카오 공유)
VITE_KAKAO_API_KEY=your_kakao_api_key

# Naver Map API (지도)
VITE_NAVER_MAP_CLIENT_ID=your_naver_client_id

# TMap API (길찾기, 선택사항)
VITE_TMAP_API_KEY=your_tmap_api_key


# ===== 서버 전용 환경변수 (PRIVATE_) =====
# Vercel/Netlify Serverless Functions에서만 사용됩니다.
# 브라우저에 노출되지 않으며, 반드시 배포 플랫폼에서 설정하세요.

# 신랑 정보
PRIVATE_GROOM_NAME=신랑이름
PRIVATE_GROOM_FIRST_NAME=이름
PRIVATE_GROOM_PHONE=010-1234-5678
PRIVATE_GROOM_MOTHER_NAME=어머니이름
PRIVATE_GROOM_MOTHER_PHONE=010-1234-5678

# 신부 정보
PRIVATE_BRIDE_NAME=신부이름
PRIVATE_BRIDE_FIRST_NAME=이름
PRIVATE_BRIDE_PHONE=010-1234-5678
PRIVATE_BRIDE_FATHER_NAME=아버지이름
PRIVATE_BRIDE_FATHER_PHONE=010-1234-5678

# 계좌번호
PRIVATE_GROOM_MOTHER_BANK=우리은행
PRIVATE_GROOM_MOTHER_ACCOUNT=1234567890
PRIVATE_GROOM_BANK=기업은행
PRIVATE_GROOM_ACCOUNT=1234567890
PRIVATE_BRIDE_BANK=카카오뱅크
PRIVATE_BRIDE_ACCOUNT=1234567890

# 이미지는 환경변수가 아니라 config/images.ts에서 관리합니다.
